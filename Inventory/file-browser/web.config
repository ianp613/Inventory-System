<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: block direct web access to config.json and the src folder. -->
<configuration>
  <system.webServer>
    <defaultDocument><files><clear /><add value="index.php" /></files></defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="src" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".json" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
