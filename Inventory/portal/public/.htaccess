# Apache: UniFi redirects guests to /guest/s/<site-id>/?id=<mac>&ap=<ap-mac>&ssid=<ssid>&url=<original-url>
RewriteEngine On
RewriteRule ^guest/s/([^/]+)/?$ guest/index.php?site=$1 [QSA,L]
# some controllers also append "index.html"-style paths
RewriteRule ^guest/s/([^/]+)/.*$ guest/index.php?site=$1 [QSA,L]

Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
